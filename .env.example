# Optional customization template for the Docker Compose run path.
#
# You do NOT need this file for the default demo: docker-compose.yml carries
# the same synthetic defaults inline, so `docker compose up --build` works
# from a fresh clone. Copy it to .env only when you want to override values:
#
#     cp .env.example .env
#
# The service itself does NOT parse .env — it reads process environment
# variables only (getenv). Docker Compose loads .env automatically; a native
# run does not, so export the variables yourself:
#
#     set -a; . ./.env; set +a
#
# Every credential below is synthetic and exists for local demonstration.
# Do not reuse these values in any real environment.

# --- PostgreSQL container ---------------------------------------------------
# Single source of truth for the demo credentials: docker-compose.yml builds
# DATABASE_URL from these three values, so the password lives in one place.
POSTGRES_DB=sqlproxy
POSTGRES_USER=sqlproxy
POSTGRES_PASSWORD=sqlproxy_demo_password

# --- Proxy service ----------------------------------------------------------
PORT=8080
DB_STATEMENT_TIMEOUT_MS=5000

# Under Compose, AUDIT_LOG_PATH is set to the mounted volume and normally
# needs no override:
# AUDIT_LOG_PATH=/var/lib/sql-proxy/audit.jsonl

# DATABASE_URL is constructed by docker-compose.yml for the container path.
# Set it explicitly ONLY for a native (non-Docker) run. Natively, prefer
# keeping the password in ~/.pgpass and omitting it from the URL:
# DATABASE_URL=postgresql://sql_proxy_user@localhost:5432/sql_proxy
